# ============================================================
# INTERCONNECT 環境変数テンプレート
# 用途別にグループ化しています。値はプレースホルダーのため必ず置換してください。
# DEPLOY.md §2.2 (必須) / §2.3 (任意) と一致させています。
# ============================================================

# --- アプリ URL (OAuth redirect_uri 組み立てに使用) ---
# NEXT_PUBLIC_APP_URL: src/lib/calendar/google.ts, providers/microsoft.ts,
#   /api/v1/calendar/{connect,callback,microsoft/connect,microsoft/callback} で参照
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Next.js + legacy 共通) ---
# NEXT_PUBLIC_SUPABASE_URL/ANON_KEY: client/middleware/server すべての Supabase 接続
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# SUPABASE_URL/SERVICE_KEY: server-side で RLS をバイパスするとき (src/lib/supabase/server.ts, jobs/queue.ts)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
# SUPABASE_SERVICE_ROLE_KEY: scripts/smoke-test-supabase.ts と supabase/functions/* (Deno) のみが参照する別名
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- 暗号化キー / 秘密鍵 ---
# CALENDAR_TOKEN_ENCRYPTION_KEY: 64文字hex (32バイト) — src/lib/calendar/crypto.ts で OAuth トークンを AES-GCM 暗号化
#   生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CALENDAR_TOKEN_ENCRYPTION_KEY=<64-hex-chars>
# CALENDAR_FEED_SECRET: src/lib/calendar/feed-token.ts (ICS署名) と oauth-state.ts (OAuth state HMAC) で共用
#   生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CALENDAR_FEED_SECRET=<random-base64url>
# CRON_SECRET: Vercel Cron 認証. /api/v1/calendar/cron, /api/v1/jobs/cron, /api/v1/retention/cron で Bearer 検証
CRON_SECRET=<random-string>

# --- Google Calendar OAuth ---
# /api/v1/calendar/{connect,callback} と src/lib/calendar/google.ts で参照
# redirect_uri は NEXT_PUBLIC_APP_URL から自動組み立て (本番: https://inter-connect.app/api/v1/calendar/callback)
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>

# --- Microsoft Graph (Outlook) OAuth ---
# /api/v1/calendar/microsoft/{connect,callback} と src/lib/calendar/providers/microsoft.ts で参照
MICROSOFT_CLIENT_ID=<azure-app-client-id>
MICROSOFT_CLIENT_SECRET=<azure-app-client-secret>
# MICROSOFT_TENANT_ID: 既定は "common" (マルチテナント). 単一テナントの場合のみ tenant GUID を指定
MICROSOFT_TENANT_ID=common

# --- Zoom (Webhook 受信) ---
# ZOOM_WEBHOOK_SECRET: /api/v1/webhooks/zoom で署名検証
ZOOM_WEBHOOK_SECRET=<zoom-webhook-secret>
# NOTE: ZOOM_VERIFICATION_TOKEN は C3 パッチで廃止 (DEPLOY.md §2.3)

# --- AI (Haiku 会議検知 + Opus 議事録分析) ---
# ANTHROPIC_API_KEY: src/lib/chat/meeting-detector.ts (Haiku) と Agent A 分析パイプライン (Opus)
ANTHROPIC_API_KEY=<anthropic-api-key>

# --- Deepgram (Agent A 文字起こし) ---
# DEEPGRAM_API_KEY: src/lib/agent-a/ingest.ts で音声→テキスト変換
DEEPGRAM_API_KEY=<deepgram-api-key>

# --- Supabase Edge Functions (Deno ランタイム) ---
# 以下は supabase/functions/* でのみ参照 (Vercel 側では不要)
TIMEREX_API_KEY=<timerex-api-key>
TIMEREX_BOOKING_PAGE_ID=interconnect-consultation
TIMEREX_WEBHOOK_SECRET=<timerex-webhook-secret>
TLDV_WEBHOOK_SECRET=<tldv-webhook-secret>
ALLOWED_ORIGIN=https://inter-connect.app

# --- LINE (legacy LIFF / OAuth — 旧 HTML 側のみ) ---
# Next.js 側では未使用. legacy login.html / register.html / line-callback.html で利用
LINE_CHANNEL_ID=<line-channel-id>
LINE_CHANNEL_SECRET=<line-channel-secret>
NEXT_PUBLIC_LINE_CHANNEL_ID=<line-channel-id>
NEXT_PUBLIC_LINE_REDIRECT_URI=https://inter-connect.app/line-callback.html
NEXT_PUBLIC_LIFF_ID=2009174893-SzFZ1PZM

# --- CI/CD (GitHub Secrets) ---
# NETLIFY_AUTH_TOKEN / NETLIFY_SITE_ID は legacy (Netlify) デプロイで使用
# Vercel 側は `vercel link` + Project Settings で管理 (.env には書かない)

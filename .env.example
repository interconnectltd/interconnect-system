# ============================================================
# INTERCONNECT 環境変数テンプレート
# 用途別にグループ化しています。値はダミーのため必ず置換してください。
# ============================================================

# --- Supabase (Next.js + legacy 共通) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>

# --- 暗号化キー ---
# CALENDAR_TOKEN_ENCRYPTION_KEY: 64文字hex (32バイト)
#   生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CALENDAR_TOKEN_ENCRYPTION_KEY=<64-hex-chars>
# CALENDAR_FEED_SECRET: 任意の長い秘密文字列
#   生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CALENDAR_FEED_SECRET=<random-base64url>
# CRON_SECRET: Vercel Cron 認証用. /api/v1/calendar/cron と /api/v1/retention/cron が要求
CRON_SECRET=<random-string>

# --- Google Calendar OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://inter-connect.app/api/v1/calendar/callback (本番), http://localhost:3000/api/v1/calendar/callback (開発)

# --- Microsoft Graph (Outlook) OAuth ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI

# --- Zoom (Server-to-Server OAuth + Webhook) ---
ZOOM_WEBHOOK_SECRET=
# ZOOM_VERIFICATION_TOKEN は廃止しました(C3パッチ)

# --- AI (Haiku 会議検知 + Opus 分析) ---
ANTHROPIC_API_KEY=

# --- Deepgram (Agent A 文字起こし) ---
DEEPGRAM_API_KEY=

# --- LINE (legacy LIFF/OAuth) ---
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
NEXT_PUBLIC_LINE_CHANNEL_ID=
NEXT_PUBLIC_LINE_REDIRECT_URI=
NEXT_PUBLIC_LIFF_ID=2009174893-SzFZ1PZM

# --- CI/CD (GitHub Secrets, Vercel) ---
# NETLIFY_AUTH_TOKEN / NETLIFY_SITE_ID は legacy デプロイで使用
